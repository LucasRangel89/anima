// ANIMA — Analisador Narrativo Inteligente Multiagente
// Prisma schema (SQLite)
//
// Todas as alterações desde a v0.2 são aditivas (colunas novas com default/opcionais):
// bancos existentes podem ser atualizados com `npm run db:push` sem perda de dados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Uma execução completa do pipeline: Pesquisador -> Especialistas -> Síntese
model Analysis {
  id              String        @id @default(cuid())
  title           String
  hint            String? // dica de desambiguação informada pelo usuário (autor/ano/diretor)
  focus           String? // recorte pedido (capítulo, temporada, personagem, aspecto)
  kind            String        @default("auto") // auto | book | film | series | game | theatre | comics | other
  depth           String        @default("standard") // brief | standard | deep | exhaustive
  // queued | researching | analyzing | synthesizing | completed | failed | interrupted
  status          String        @default("researching")
  research        String? // dossiê factual em Markdown (saída do Agente Pesquisador)
  // pending | running | done | failed
  researchStatus  String        @default("pending")
  sources         String? // JSON: fontes consultadas pelo pesquisador
  userSources     String? // JSON: links e trechos enviados pelo usuário
  synthesis       String? // síntese integrada em Markdown (saída do Curador)
  synthesisStatus String        @default("pending")
  error           String?
  durationMs      Int?
  model           String? // modelo de LLM usado (rastreabilidade)
  usage           String? // JSON: chamadas, tokens e avisos de contexto reduzido
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  results         AgentResult[]

  @@index([status])
  @@index([createdAt])
}

// Resultado individual de cada agente especialista
model AgentResult {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  // structural | narratology | characters | thematic | stylistic | psychological | cultural | critical
  agentKey   String
  // pending | running | done | failed
  status     String   @default("pending")
  content    String? // análise em Markdown
  error      String?
  durationMs Int?

  @@unique([analysisId, agentKey])
}
