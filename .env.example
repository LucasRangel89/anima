# ──────────────────────────────────────────────────────────────
# ANIMA — variáveis de ambiente (copie para .env e preencha)
# ──────────────────────────────────────────────────────────────

# Banco de dados (SQLite). Caminho relativo à pasta prisma/
DATABASE_URL="file:../db/anima.db"
# ANIMA_STORE=memory  # sem banco: tudo em memória (demonstração e testes)

# ── Provedor de LLM ───────────────────────────────────────────
# openai  -> qualquer API compatível com OpenAI (OpenAI, OpenRouter, Groq,
#            Gemini via endpoint OpenAI, Ollama, LM Studio, Z.ai/GLM...)
# zai     -> SDK z-ai-web-dev-sdk (somente dentro do ambiente Z.ai)
# mock    -> respostas fictícias, sem custo (demonstração e testes)
# Se omitido: "openai" quando LLM_API_KEY existir; senão "zai".
LLM_PROVIDER=openai

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Máximo de chamadas de LLM simultâneas, global (reduza se receber erros 429)
LLM_CONCURRENCY=3
# Timeout por chamada, em segundos
LLM_TIMEOUT_SECONDS=180

# ── Fila de análises ──────────────────────────────────────────
# Análises simultâneas neste processo; o excedente espera na fila
ANIMA_MAX_ACTIVE=3
# Tamanho máximo da fila (pedidos além disso são recusados com 429)
ANIMA_MAX_QUEUE=8

# ── Fontes ────────────────────────────────────────────────────
# Sem chave nenhuma o ANIMA usa as fontes abertas:
#   Wikipédia (pt/en), Open Library e OpenAlex.
#
# TMDB (opcional): ficha técnica de filmes e séries.
TMDB_API_KEY=
# Tavily (opcional): resenhas, entrevistas e crítica de imprensa.
TAVILY_API_KEY=

# ── Interface ─────────────────────────────────────────────────
# Usado em metadados/Open Graph; defina em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
