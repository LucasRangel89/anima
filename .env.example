# ──────────────────────────────────────────────────────────────
# ANIMA — variáveis de ambiente (copie para .env e preencha)
# ──────────────────────────────────────────────────────────────

# Banco de dados (SQLite). Caminho relativo à pasta prisma/
DATABASE_URL="file:../db/anima.db"
# ANIMA_STORE=memory  # sem banco: tudo em memória (demonstração e testes)

# ── Provedor de LLM ───────────────────────────────────────────
# openai  -> qualquer API compatível com OpenAI (OpenAI, OpenRouter, Groq,
#            Gemini via endpoint OpenAI, Ollama, LM Studio, Z.ai/GLM...)
# zai     -> SDK z-ai-web-dev-sdk (somente dentro do ambiente Z.ai)
# mock    -> respostas fictícias, sem custo (demonstração e testes)
# Se omitido: "openai" quando LLM_API_KEY existir; senão "zai".
LLM_PROVIDER=openai

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Presets gratuitos (escolha UM e descomente) ───────────────
# Nenhum deles pede cartão. Confira os nomes de modelo: mudam com frequência —
# a lista atualizada está no link indicado em cada bloco.
#
# Custo por análise completa (8 lentes + dossiê + síntese = 10 chamadas):
#   Panorama (4 lentes) ≈ 6 chamadas · Padrão (8) ≈ 10 · Exaustiva (8) ≈ 10 com saídas maiores.
# Se o provedor limitar por minuto, comece com profundidade "Panorama" e LLM_CONCURRENCY=1.

# Google Gemini — camada gratuita (limites por modelo mudam; veja-os em
# https://aistudio.google.com/rate-limit — o ANIMA não chuta números aqui)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=sua-chave-do-ai-studio
# LLM_MODEL=gemini-2.5-flash            # confira em ai.google.dev/gemini-api/docs/models
# LLM_CONCURRENCY=1

# Groq — camada gratuita. Limites publicados em 02/11/2026 para openai/gpt-oss-120b:
# 30 req/min, 1.000 req/dia, 8.000 tokens/min. O teto de TOKENS POR MINUTO é o que morde:
# uma análise exaustiva gasta mais que isso em poucos minutos, então use Panorama/Padrão
# e LLM_CONCURRENCY=1. Tabela viva: console.groq.com/docs/rate-limits
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=sua-chave-da-groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_CONCURRENCY=1

# OpenRouter — modelos ":free". Limites publicados em 02/11/2026 (conta sem crédito comprado):
# 20 req/min e 50 req/dia. Com 10 chamadas por análise, são ~5 análises por dia.
# Lista de modelos gratuitos: openrouter.ai/models?max_price=0
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sua-chave-do-openrouter
# LLM_MODEL=escolha-um-id-terminado-em-:free
# LLM_CONCURRENCY=2

# Ollama — roda no seu computador: sem limite, sem chave, sem custo. Precisa de RAM
# suficiente para o modelo (um 7B quantizado pede ~6 GB). Ex.: `ollama pull qwen2.5:7b`.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama                      # o Ollama ignora, mas o cliente exige um valor
# LLM_MODEL=qwen2.5:7b
# LLM_CONCURRENCY=1

# Modelo alternativo usado quando o principal devolve 429 persistente (limite de uso).
# Deve apontar para um modelo do MESMO endpoint acima (mesma base URL e chave).
# Sem isto, um 429 encerra a análise com mensagem clara, em vez de tentar para sempre.
LLM_FALLBACK_MODEL=

# Contexto do modelo, em tokens. O ANIMA reserva a saída e reduz o dossiê/análises para caber;
# toda redução é avisada no relatório. Padrão conservador: 32768.
# Aumente se seu modelo suporta mais (ex.: 128000); reduza em modelos pequenos (ex.: 8192).
LLM_CONTEXT_TOKENS=32768

# Máximo de chamadas de LLM simultâneas, global. Padrão 2.
# Em planos gratuitos (Groq, OpenRouter, Gemini) use 1: eles limitam por minuto.
LLM_CONCURRENCY=2
# Timeout por chamada, em segundos
LLM_TIMEOUT_SECONDS=180

# ── Fila de análises ──────────────────────────────────────────
# Análises simultâneas neste processo; o excedente espera na fila
ANIMA_MAX_ACTIVE=3
# Tamanho máximo da fila (pedidos além disso são recusados com 429)
ANIMA_MAX_QUEUE=8

# ── Fontes ────────────────────────────────────────────────────
# Sem chave nenhuma o ANIMA usa as fontes abertas:
#   Wikipédia (pt/en), Open Library e OpenAlex.
#
# TMDB (opcional): ficha técnica de filmes e séries.
TMDB_API_KEY=
# Tavily (opcional): resenhas, entrevistas e crítica de imprensa.
TAVILY_API_KEY=

# ── Interface ─────────────────────────────────────────────────
# Usado em metadados/Open Graph; defina em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
