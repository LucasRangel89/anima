diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index 9082790..6de6d31 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -1,5 +1,8 @@
 // ANIMA — Analisador Narrativo Inteligente Multiagente
 // Prisma schema (SQLite)
+//
+// Alterações da v0.3 são aditivas (colunas novas com default/opcionais):
+// bancos existentes podem ser atualizados com `npm run db:push` sem perda de dados.
 
 generator client {
   provider = "prisma-client-js"
@@ -10,20 +13,30 @@ datasource db {
   url      = env("DATABASE_URL")
 }
 
-// Uma execução completa do pipeline: Pesquisador -> 6 Especialistas -> Relatório
+// Uma execução completa do pipeline: Pesquisador -> Especialistas -> Síntese
 model Analysis {
-  id             String       @id @default(cuid())
-  title          String
-  // researching | analyzing | completed | failed
-  status         String       @default("researching")
-  research       String? // dossiê factual em Markdown (saída do Agente Pesquisador)
+  id              String        @id @default(cuid())
+  title           String
+  hint            String? // dica de desambiguação informada pelo usuário (autor/ano/diretor)
+  kind            String        @default("auto") // auto | book | film | series | game | theatre | comics | other
+  depth           String        @default("standard") // standard | deep
+  // researching | analyzing | synthesizing | completed | failed | interrupted
+  status          String        @default("researching")
+  research        String? // dossiê factual em Markdown (saída do Agente Pesquisador)
   // pending | running | done | failed
-  researchStatus String       @default("pending")
-  error          String?
-  durationMs     Int?
-  createdAt      DateTime     @default(now())
-  updatedAt      DateTime     @updatedAt
-  results        AgentResult[]
+  researchStatus  String        @default("pending")
+  sources         String? // JSON: fontes consultadas pelo pesquisador
+  synthesis       String? // síntese integrada em Markdown (saída do Curador)
+  synthesisStatus String        @default("pending")
+  error           String?
+  durationMs      Int?
+  model           String? // modelo de LLM usado (rastreabilidade)
+  createdAt       DateTime      @default(now())
+  updatedAt       DateTime      @updatedAt
+  results         AgentResult[]
+
+  @@index([status])
+  @@index([createdAt])
 }
 
 // Resultado individual de cada agente especialista
@@ -31,12 +44,13 @@ model AgentResult {
   id         String   @id @default(cuid())
   analysisId String
   analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
-  // structural | characters | thematic | stylistic | psychological | cultural
+  // structural | narratology | characters | thematic | stylistic | psychological | cultural | critical
   agentKey   String
   // pending | running | done | failed
   status     String   @default("pending")
   content    String? // análise em Markdown
   error      String?
   durationMs Int?
+
   @@unique([analysisId, agentKey])
 }
